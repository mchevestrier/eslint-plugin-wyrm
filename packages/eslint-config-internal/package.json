{
  "name": "@eslint-plugin-wyrm/eslint-config-internal",
  "version": "0.0.0",
  "private": true,
  "description": "Internal ESLint config",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./eslint.config.ts",
    "./package.json": "./package.json"
  },
  "main": "./eslint.config.ts",
  "scripts": {
    "fix:format": "prettier --write .",
    "fix:js": "eslint . --fix",
    "lint:format": "prettier --check .",
    "lint:js": "eslint ."
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
    "@eslint-plugin-wyrm/eslint-plugin-internal": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitest/eslint-plugin": "^1.6.23",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-command": "^3.5.3",
    "eslint-plugin-eslint-plugin": "^7.4.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-package-json": "~1.6.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^71.1.0",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2"
  },
  "devDependencies": {
    "@e18e/eslint-plugin": "^0.5.1",
    "@types/node": "^24.11.0",
    "eslint": "^10.2.1",
    "prettier": "^3.8.3"
  },
  "peerDependencies": {
    "eslint": "^10.2.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
